# GEMINI_API_KEY: Google Gemini API key for live AI Smart Tutor RAG, Flashcard Quiz & explanations
# Generate your free key in Google AI Studio
GEMINI_API_KEY=""

# CHROMA_API_KEY: ChromaDB Cloud API key for vector embeddings and RAG note storage
CHROMA_API_KEY=""

# CHROMA_TENANT: ChromaDB Cloud tenant ID
CHROMA_TENANT=""

# CHROMA_DATABASE: ChromaDB Cloud database name
CHROMA_DATABASE="rag-notes-application1"

# OPENROUTER_API_KEY: Primary AI key for AI Smart Tutor RAG, Flashcard Quiz & Document extraction
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# GROQ_API_KEY: Ultra-fast AI inference key for Llama 3.3 70B & Mixtral
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=""

# APP_URL / BACKEND_URL: Production backend service URL on Render
APP_URL="https://student-notes-hub-2.onrender.com"
VITE_BACKEND_URL="https://student-notes-hub-2.onrender.com"
